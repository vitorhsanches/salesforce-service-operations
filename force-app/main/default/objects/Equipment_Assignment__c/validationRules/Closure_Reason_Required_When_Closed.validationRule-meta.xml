<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Closure_Reason_Required_When_Closed</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(End_Date__c)),
    ISBLANK(TEXT(Closure_Reason__c))
)</errorConditionFormula>
    <errorMessage>Closure Reason is required when an Equipment Assignment is closed.</errorMessage>
</ValidationRule>
