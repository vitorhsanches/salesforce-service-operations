<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Temporary_Reason_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Assignment_Type__c, &quot;Temporary&quot;),
    ISBLANK(TEXT(Temporary_Reason__c))
)</errorConditionFormula>
    <errorDisplayField>Temporary_Reason__c</errorDisplayField>
    <errorMessage>Temporary Reason is required when Assignment Type is Temporary.</errorMessage>
</ValidationRule>
